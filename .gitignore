# Godot 4
.godot/
/android/

# gs-core is a separate repository. For local development, symlink it:
#   ln -s ../../gs-core/addons/gs_core addons/gs_core
# Consumers copy both addons into their own project.
/addons/gs_core

# gs-map and gs-server are OPTIONAL for this addon and are linked only so the
# self-test can run the integrations against the real thing. Without them the suite
# still runs and says out loud that those sections were not covered — which is the
# point: "0 failures" from a suite that ran nothing is how two ends never meet.
/addons/gs_map
/addons/gs_server

# Exports
build/
export_presets.cfg

# OS
.DS_Store
Thumbs.db

# Editors
.vscode/

# Sibling addons linked for local suites (absolute links must never be tracked; CI resolves them from addons.lock):
/addons/gs_auth
/addons/gs_cloud
/addons/gs_moderation
/addons/gs_sql
/addons/gs_voice
